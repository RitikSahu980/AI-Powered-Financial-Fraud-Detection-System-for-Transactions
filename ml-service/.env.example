# Copy this file to .env and adjust values for your environment.
# See app/config/settings.py for the authoritative definition of each field.

SERVICE_NAME=fraud-detection-ml-service

# Identifies which saved pipeline artifact produced predictions. Not read
# from the pickle itself - set deliberately per deployment/model version.
MODEL_VERSION=xgboost_v1

# Path to the saved joblib pipeline artifact, relative to the working
# directory the process is started from (or absolute).
MODEL_PATH=online_payment_fraud_detection_model.pkl

HOST=0.0.0.0
PORT=8000

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
# NEVER use DEBUG in production - it logs full feature vectors, including
# raw transaction amounts.
LOG_LEVEL=INFO
